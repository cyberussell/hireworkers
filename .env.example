# Required for the AI Hiring Assistant, candidate matching, and AI fit summaries.
# Without this, those features show a clear "not configured" state instead of failing.
ANTHROPIC_API_KEY=

# Required for posted jobs / seeker profiles to persist (Supabase project URL
# and service_role key — server-only, never sent to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for sign-in (Google/Facebook via Supabase Auth). These are safe to
# expose client-side — they're the public anon key, not the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
